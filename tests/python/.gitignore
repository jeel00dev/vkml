# Coverage recordings (VKML_COVERAGE). Regenerated by any run; the accepted
# gaps live in docs/coverage-baseline.json, which IS tracked.
#
# Patterns in a .gitignore are relative to its own directory, so this must be
# the bare filename -- "tests/python/coverage.tsv" here would match
# tests/python/tests/python/coverage.tsv and ignore nothing.
coverage.tsv
