#version 450

// 2D max pooling, and its adjoint, in one module.
//
// BACKWARD is a specialisation constant rather than a second shader: the two
// share the window scan, the stride-boundary test and -- crucially -- the
// argmax rule, and a second file would mean keeping two copies of that rule in
// step. Getting them out of step is precisely the bug that would route a
// gradient to the wrong element while every shape still checked out.
//
// Padding is -infinity, not zero, so a window of negative values reports its
// true maximum. That is why max pooling cannot compose as a max over im2col,
// which pads with zero.
//
// THE GEOMETRY IS SPECIALISED, for the reason docs/adr/0011 establishes and
// which bites hardest here. The adjoint runs a stride test per kernel position
// and then an argmax scan inside it, so a 2x2 pool performed roughly twenty
// integer divisions by runtime values per input element. Measured against
// `relu` over the same tensor -- same traffic, one flat index:
//
//     max_pool2d_backward   51.4    30.1    24.8 GB/s
//     relu                 231.1   171.5   148.3 GB/s     5.1x to 6.7x apart
//
// With the divisors known the compiler strength-reduces every one, unrolls
// both loops, and where stride equals the kernel extent -- the ordinary
// non-overlapping pool -- it can see that only one window can reach a given
// input position and drops the rest of the scan.
//
// `BACKWARD` and `CONTIGUOUS` were already specialisation constants, so this
// adds variants along axes the pipeline cache already splits on: the geometry
// is per-layer, and a CNN has a handful of pooling layers.

#extension GL_GOOGLE_include_directive : require
#include "common.glsl"


// false: forward, one thread per pooled output element.
// true:  adjoint, one thread per INPUT element.
layout(constant_id = 1) const bool BACKWARD = false;

// Storage type of the operands and result. Conversion happens at the memory
// boundary; everything between is float (docs/ARCHITECTURE.md 7.3). The
// argmax the backward pass recovers is an index, so it is unaffected.
layout(constant_id = 2) const uint DTYPE = T_F32;

// Set when the IMAGE operand is contiguous, in which case a flat index is
// already the element offset and `image_op` is never read. Default false: a
// caller that forgets to set it gets the correct-but-slower path rather than
// wrong addresses, which is the same default unary.comp and where.comp use.
layout(constant_id = 3) const bool CONTIGUOUS = false;

// The divisors and the loop bounds. Only values this kernel DIVIDES by or
// ITERATES over are here; one it merely multiplies by would cost a pipeline
// variant and buy nothing.
layout(constant_id = 4) const int KERNEL_H = 1;
layout(constant_id = 5) const int KERNEL_W = 1;
layout(constant_id = 6) const int STRIDE_H = 1;
layout(constant_id = 7) const int STRIDE_W = 1;
layout(constant_id = 8) const int IMAGE_H = 1;
layout(constant_id = 9) const int IMAGE_W = 1;
layout(constant_id = 10) const int OUT_H = 1;
layout(constant_id = 11) const int OUT_W = 1;

layout(push_constant, scalar) uniform Params {
    uint64_t src;      // forward: input.  backward: incoming gradient.
    uint64_t image;    // backward only: the original input, for the argmax.
    uint64_t dst;
    uint  n;
    int   kernel_h, kernel_w;
    int   stride_h, stride_w;
    int   pad_h, pad_w;
    int   dilation_h, dilation_w;
    int   image_h, image_w;
    int   out_h, out_w;
    // Layout of the operand whose windows are scanned -- `src` going forward,
    // `image` coming back. Only that one can be strided: the backward rule
    // takes grad.contiguous() and input.contiguous() before building the
    // adjoint node, so the gradient and the original input always arrive packed.
    Operand image_op;
} p;

/// Element offset for a flat logical position within the image.
///
/// The flat index is `plane * H * W + h * W + x`, which is the row-major index
/// over (N, C, H, W) -- so decomposing it through the operand's extents and
/// strides is exactly what the CPU's `load<T>(in, linear)` does via
/// `linear_to_offset`. Mirroring that is what keeps the two backends agreeing
/// on a transposed input rather than merely on a packed one.
uint image_index(uint logical) {
    return CONTIGUOUS ? logical : offset_from(logical, p.image_op.ne, p.image_op.nb);
}

/// Flat offset of the first maximum within one window's kernel grid, or -1 when
/// the window lies entirely in the padding.
///
/// Row-major scan with a strict `>`, so the FIRST maximum wins -- matching
/// torch, and matching the CPU kernel it is validated against. `>=` would
/// select the last, moving the gradient whenever a window contains a tie.
/// `plane_first` is an ELEMENT index, not a byte offset. The earlier form took a
/// byte address computed as `plane * H * W * 4`, which hardcoded a 4-byte
/// element and so walked past the end of the buffer for f16: plane 0 was right
/// and every later plane read unwritten memory as zeros. Silent wrong numbers,
/// on a configuration listed as supported. Letting `load_f` do the indexing
/// keeps the arithmetic dtype-agnostic, as it is in every other kernel.
int argmax_in_window(uint64_t buf, uint plane_first, int oh, int ow) {
    float best = -1.0 / 0.0;   // -infinity
    int best_offset = -1;

    for (int ki = 0; ki < KERNEL_H; ++ki) {
        const int h = oh * STRIDE_H - p.pad_h + ki * p.dilation_h;
        if (h < 0 || h >= IMAGE_H) { continue; }

        for (int kj = 0; kj < KERNEL_W; ++kj) {
            const int x = ow * STRIDE_W - p.pad_w + kj * p.dilation_w;
            if (x < 0 || x >= IMAGE_W) { continue; }

            const float v = load_f(buf, image_index(plane_first + uint(h * IMAGE_W + x)), DTYPE);
            if (v > best) {
                best = v;
                best_offset = ki * KERNEL_W + kj;
            }
        }
    }
    return best_offset;
}

void forward(uint i) {
    const int positions = OUT_H * OUT_W;
    const int ow    = int(i) % OUT_W;
    const int oh    = (int(i) / OUT_W) % OUT_H;
    const int plane = int(i) / positions;

    const uint plane_first = uint(plane) * uint(IMAGE_H * IMAGE_W);
    const int offset = argmax_in_window(p.src, plane_first, oh, ow);

    const int h = oh * STRIDE_H - p.pad_h + (offset / KERNEL_W) * p.dilation_h;
    const int x = ow * STRIDE_W - p.pad_w + (offset % KERNEL_W) * p.dilation_w;
    store_f(p.dst, i, load_f(p.src, image_index(plane_first + uint(h * IMAGE_W + x)), DTYPE),
            DTYPE);
}

void backward(uint i) {
    const int pixels = IMAGE_H * IMAGE_W;
    const int x     = int(i) % IMAGE_W;
    const int h     = (int(i) / IMAGE_W) % IMAGE_H;
    const int plane = int(i) / pixels;

    const uint plane_first = uint(plane) * uint(pixels);

    // Pull, do not push: with a stride below the kernel extent one input
    // position can be the maximum of several windows. Pulling makes this
    // element the property of one invocation, so nothing contends and the fold
    // order is fixed -- the same reason col2im and scatter_add are inverted.
    float acc = 0.0;
    for (int ki = 0; ki < KERNEL_H; ++ki) {
        const int top = h + p.pad_h - ki * p.dilation_h;
        if (top < 0 || (top % STRIDE_H) != 0) { continue; }
        const int oh = top / STRIDE_H;
        if (oh >= OUT_H) { continue; }

        for (int kj = 0; kj < KERNEL_W; ++kj) {
            const int left = x + p.pad_w - kj * p.dilation_w;
            if (left < 0 || (left % STRIDE_W) != 0) { continue; }
            const int ow = left / STRIDE_W;
            if (ow >= OUT_W) { continue; }

            // Only the window's first maximum receives its gradient.
            if (argmax_in_window(p.image, plane_first, oh, ow) == ki * KERNEL_W + kj) {
                acc += load_f(p.src, (plane * OUT_H + oh) * OUT_W + ow, DTYPE);
            }
        }
    }
    store_f(p.dst, i, acc, DTYPE);
}

void main() {
    const uint i = global_index();
    if (i >= p.n) { return; }
    if (BACKWARD) { backward(i); } else { forward(i); }
}
