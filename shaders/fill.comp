#version 450

// Writes a constant to every element. The simplest possible kernel, chosen
// first deliberately: it exercises device creation, allocation, buffer device
// address, pipeline creation, command recording, dispatch and readback without
// any indexing logic that could also be wrong.

#extension GL_GOOGLE_include_directive : require
#include "common.glsl"

layout(local_size_x_id = 0) in;

layout(push_constant, scalar) uniform Params {
    uint64_t dst;
    uint     n;
    float    value;
} p;

void main() {
    const uint i = gl_GlobalInvocationID.x;
    if (i >= p.n) { return; }
    F32Buf(p.dst).v[i] = p.value;
}
