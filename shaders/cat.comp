#version 450

// Joins two operands along one axis.
//
// The output index is split into (outer, along, inner) around the concatenated
// axis: `inner` is the product of the extents after it, `outer` everything
// before, so an element's position along the axis is `(i / inner) % extent`.
// Positions below the first operand's extent come from it, the rest from the
// second with the offset subtracted.
//
// Each source index is rebuilt with the *source's* own axis extent. Reusing the
// output's extent would read past the end of the shorter operand -- the same
// trap the CPU kernel documents, and the reason both compute it the same way.

#extension GL_GOOGLE_include_directive : require
#include "common.glsl"


// Storage type of the operands and result. Conversion happens at the memory
// boundary; everything between is float (docs/ARCHITECTURE.md 7.3).
layout(constant_id = 2) const uint DTYPE = T_F32;

// Only removes the operand-offset mapping. The index arithmetic below is
// required either way, because a source position is never equal to the output
// position except in the degenerate case of an empty second operand.
layout(constant_id = 1) const bool CONTIGUOUS = false;

layout(push_constant, scalar) uniform Params {
    uint64_t a;
    uint64_t b;
    uint64_t dst;
    uint     n;
    uint     inner;       // product of extents after the joined axis
    uint     out_extent;  // joined axis extent of the output
    uint     a_extent;    // joined axis extent of the first operand
    uint     b_extent;    // and of the second
    uint     axis;        // joined axis, indexing the PADDED extent array
    Operand  out_op;
    uvec4    a_nb;        // strides only: the extents are derived below
    uvec4    b_nb;
} p;

/// The operand's extents, rebuilt from the output's.
///
/// cat rejects operands that differ on any axis but the joined one, so an
/// input's extents are the output's with `axis` replaced by its own share of
/// that axis. Sending them outright cost 16 bytes each and put this block over
/// the 128 Vulkan guarantees; deriving them is what brings it under (issue #2,
/// docs/adr/0009 sec2). The host re-checks the invariant every dispatch.
///
/// `axis` is uniform across the workgroup, so the dynamic component index is a
/// scalar operation rather than a per-lane one.
Operand operand_along(uint extent, uvec4 nb) {
    Operand op;
    op.ne = p.out_op.ne;
    op.ne[p.axis] = extent;
    op.nb = nb;
    return op;
}

void main() {
    const uint i = global_index();
    if (i >= p.n) { return; }

    const uint rest  = i % p.inner;
    const uint along = (i / p.inner) % p.out_extent;
    const uint outer = i / (p.inner * p.out_extent);

    const bool from_a = along < p.a_extent;
    const uint extent = from_a ? p.a_extent : p.b_extent;
    const uint pos    = from_a ? along : along - p.a_extent;
    const uint linear = (outer * extent + pos) * p.inner + rest;

    const uint di = CONTIGUOUS ? i : operand_offset(i, p.out_op);

    if (from_a) {
        const uint si =
            CONTIGUOUS ? linear : operand_offset(linear, operand_along(p.a_extent, p.a_nb));
        store_f(p.dst, di, load_f(p.a, si, DTYPE), DTYPE);
    } else {
        const uint si =
            CONTIGUOUS ? linear : operand_offset(linear, operand_along(p.b_extent, p.b_nb));
        store_f(p.dst, di, load_f(p.b, si, DTYPE), DTYPE);
    }
}
