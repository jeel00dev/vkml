#version 450

// Stage 1 reference GEMM: one invocation computes one output element.
//
// Deliberately the simplest thing that can be correct:
//   - no shared memory
//   - no tiling
//   - no vectorization
//   - no subgroup operations
//
// Its job is to be a Vulkan implementation whose results match the CPU oracle,
// so that every later optimisation has something trustworthy to be compared
// against. Performance is explicitly irrelevant here.
//
// ACCUMULATION -- one place where "simplest" is NOT chosen
// -------------------------------------------------------
// The K loop uses the same pairwise carry stack as reduce.comp rather than a
// flat running sum. That is not gold-plating: the project's BACKWARD tolerance
// policy derives its bound from `(B + log2(n/B))*eps` for pairwise summation,
// and a sequential accumulator's error is `n*eps` -- roughly 7x wider at
// K=256 and 50x at K=4096. Using sequential accumulation here would force a
// looser tolerance, and loosening tolerances to make an implementation pass is
// exactly what the project forbids.
//
// The carry stack costs registers, not shared memory or cross-lane
// communication, so it stays within Stage 1's constraints.

#extension GL_GOOGLE_include_directive : require
#include "common.glsl"

layout(local_size_x_id = 0) in;

// Storage types. DTYPE is the OPERANDS'; OUT_DTYPE is the destination's, and
// they differ in exactly one case: under split-K this kernel writes f32 partial
// sums into a workspace rather than the output, because rounding a partial sum
// to 16 bits before the final fold would break fp32 accumulation across the
// split (docs/ARCHITECTURE.md 7.3) just as surely as a 16-bit accumulator does.
// Shared tiles and the register accumulators stay float in every case.
layout(constant_id = 1) const uint DTYPE = T_F32;
layout(constant_id = 2) const uint OUT_DTYPE = T_F32;

layout(push_constant, scalar) uniform Params {
    uint64_t a;
    uint64_t b;
    uint64_t d;
    uint     n_out;   // total output elements = B0*B1*M*N
    uint     b1;      // second batch extent
    uint     m;
    uint     n;
    uint     k;
    Operand  op_a;    // [B0, B1, M, K]
    Operand  op_b;    // [B0, B1, K, N]
} p;

#define STACK_LEVELS 24

void main() {
    const uint gid = gl_GlobalInvocationID.x;
    if (gid >= p.n_out) { return; }

    // Decompose the flat id into (batch0, batch1, row, col). The output is
    // always freshly allocated and contiguous, so a flat index addresses it
    // directly; only A and B need strided access.
    const uint col   = gid % p.n;
    const uint rest0 = gid / p.n;
    const uint row   = rest0 % p.m;
    const uint rest1 = rest0 / p.m;
    const uint i1    = rest1 % p.b1;
    const uint i0    = rest1 / p.b1;

    // Base offsets of this thread's row of A and column of B. Strides come from
    // the operands, so broadcast batches (stride 0) work with no special case.
    const uint a_base = i0 * p.op_a.nb[0] + i1 * p.op_a.nb[1] + row * p.op_a.nb[2];
    const uint b_base = i0 * p.op_b.nb[0] + i1 * p.op_b.nb[1] + col * p.op_b.nb[3];
    const uint a_step = p.op_a.nb[3];
    const uint b_step = p.op_b.nb[2];

    float stack[STACK_LEVELS];
    uint count = 0;

    uint kk = 0;
    while (kk < p.k) {
        // Blocks of 32 accumulated sequentially, matching kPairwiseBlock in
        // src/backend/cpu/reduce.h so the two backends fold in the same order.
        precise float block = 0.0;
        for (uint t = 0; t < 32u && kk < p.k; ++t, ++kk) {
            block += load_f(p.a, a_base + kk * a_step, DTYPE) *
                     load_f(p.b, b_base + kk * b_step, DTYPE);
        }
        uint c = count++;
        uint level = 0;
        while ((c & 1u) == 1u) { block += stack[level]; c >>= 1u; ++level; }
        stack[level] = block;
    }

    float acc = 0.0;
    for (uint level = 0; level < STACK_LEVELS; ++level) {
        if (((count >> level) & 1u) == 1u) { acc += stack[level]; }
    }

    store_f(p.d, gid, acc, OUT_DTYPE);
}
