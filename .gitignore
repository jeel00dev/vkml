.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.hypothesis/
*.so
*.pyd

# editors / tools
.cache/
compile_commands.json
.vscode/
.idea/
*.swp

# benchmark + test artifacts
bench/results/*.json
tests/data/
# coverage recording, written wherever VKML_COVERAGE points (CI uses the root)
coverage.tsv

# third-party reference clones (read-only study material, not vendored)
third_party/reference/

# Assistant configuration.
#
# The SKILLS are tracked. cpp_spec is the engineering constitution and handbook
# this repository is actually held to -- the same standards CONTRIBUTING.md
# describes in prose -- so it belongs with the code rather than on one laptop.
# Tracking it also means a fresh clone is fully set up: Claude Code discovers
# project-level .claude/skills automatically, with nothing to symlink or copy.
#
# Everything else under .claude/ is per-machine session state and settings, and
# stays out. The pattern is deny-by-default so a new local file is ignored
# unless it is deliberately added here.
.claude/*
!.claude/skills/

# Process documents -- milestone reviews, audits, roadmaps -- used to be ignored
# here, on the grounds that they record how the work was run rather than how the
# library works. They are tracked now: they are the reasoning behind decisions
# the code does not explain on its own, they are worth having on every machine
# the project is developed from, and a document only one laptop holds is one
# nobody can cite. Nothing in docs/ is ignored.

# Self-hosted Actions runner. Lives here for convenience; it is NOT part of
# the project. Ignored so `git status` stays readable and, more importantly, so
# a `git clean -xfd` does not delete a runner that is mid-job.
actions-runner/

# Generated documentation site. Rebuild with `python web/build.py`.
web/_site/
